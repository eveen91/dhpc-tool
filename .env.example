# Local development values only. Do not put production secrets in this file.
POSTGRES_DB=dhcp_manager
POSTGRES_USER=dhcp_manager
POSTGRES_PASSWORD=replace-with-local-development-password
DHCP_MANAGER_DATABASE_URL=postgresql+psycopg://dhcp_manager:replace-with-local-development-password@db:5432/dhcp_manager
DHCP_MANAGER_REDIS_URL=redis://redis:6379/0
DHCP_MANAGER_ENVIRONMENT=development
# Must remain false until lab validation of wrapper commands and ClusterXL behaviour.
DHCP_MANAGER_DEPLOYMENT_EXECUTION_ENABLED=false
